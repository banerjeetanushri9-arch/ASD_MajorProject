# GharDrishya — React Frontend Environment Variables
# Copy this to .env.local and customise

# Backend API base URL (default: proxied via Vite to localhost:3000)
# VITE_API_BASE=http://localhost:3000/api

# Admin credentials (for reference only — handled in AdminLogin.jsx)
# VITE_ADMIN_USER=admin
# VITE_ADMIN_PASS=admin123
